# In 'config_user' put your personal configuration
#
# [user]
#      email = email@addre.sse
#      name = Your Name

[include]
    path = config_user.inc
[push]
    default = upstream
[alias]
    l = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad)%Creset %C(bold blue)<%an>%Creset'
    crepe = grep
    curbranch = rev-parse --abbrev-ref HEAD
[pull]
    rebase = merges
[rerere]
    autoupdate = true
    enabled = true
[user]
    signingkey = 52F772ECAC892F69
[gpg]
    program = /usr/bin/gpg2
[diff]
    colorMoved = default
[color]
    ui = auto

